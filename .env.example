# Backend API used by the browser (the NestJS server in ./backend). Vite itself runs on 3000, so the API uses 3001.
# No AI provider key belongs in the frontend: Claude is reached only through the backend.
VITE_API_BASE_URL=http://localhost:3001

# GitHub Pages / presentations (public values only; never put a secret here)
# VITE_BASE_PATH=/noobsabhaeducaro/   # base path when served under a repository subpath
# VITE_DEMO_MODE=true                 # open in the clearly labelled, simulated DEMO MODE
