# --- Server ---
# 3001: the Vite frontend uses 3000 and expects the API here (VITE_API_BASE_URL).
PORT=3001

# --- Database (PostgreSQL) ---
# Works with any Postgres. For a zero-install local DB run `npm run db:dev`
# (embedded Postgres, port taken from this URL, database "ai_applicant").
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ai_applicant?schema=public"

# --- Google Gemini (document transcription/extraction + the agent) ---
# Without a key, processing fails with a readable error and the agent uses its deterministic fallback.
# Put the real key only in your local, gitignored backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Authentication ---
# Secret that signs login tokens. REQUIRED (min 32 chars), server-side only, never commit the real value.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login stays valid (e.g. 8h, 30m).
JWT_EXPIRES_IN=8h

# --- Documents ---
UPLOAD_DIR=./uploads
# Production (Render): a persistent disk path, e.g. UPLOAD_DIR=/var/data/uploads (see ../DEPLOY_RENDER.md).

# --- CORS ---
# Comma-separated browser origins allowed to call this API (the deployed frontend).
# Leave unset for local development (permissive). Set it in production.
# CORS_ORIGINS=https://your-frontend.vercel.app
