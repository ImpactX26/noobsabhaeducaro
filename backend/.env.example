# --- Server ---
PORT=3000

# --- Database (PostgreSQL) ---
# Works with any Postgres. For a zero-install local DB run `npm run db:dev`
# (embedded Postgres on port 5433, database "ai_applicant").
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_applicant?schema=public"

# --- Anthropic (not used until the LLM stage) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Documents ---
UPLOAD_DIR=./uploads
